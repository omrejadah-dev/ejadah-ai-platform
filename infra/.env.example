# Copy to infra/.env on the server and fill in. Never commit the filled file.
POSTGRES_PASSWORD=change-me
# 64+ random characters, e.g.: openssl rand -base64 64 | tr -d '\n'
JWT_SIGNING_KEY=change-me-to-64-or-more-random-characters-change-me-to-64-or-more-random-characters
# empty = trial AI reader; set to switch to Claude
ANTHROPIC_API_KEY=
PUBLIC_ORIGIN=https://ai.ejadah.example
# hosted map tiles (OSM's servers are not for production traffic), e.g. MapTiler:
TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
TAG=latest
