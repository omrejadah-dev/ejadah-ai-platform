# Local rehearsal of the production stack on a dev machine (not a secret: dev-only values).
# Reuses the dev database (infra/docker-compose.yml on host port 5434); nginx on :8080, no TLS.
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/local-rehearsal.env up -d --build
POSTGRES_PASSWORD=ejadah_dev
DB_CONNECTION=Host=host.docker.internal;Port=5434;Username=ejadah;Password=ejadah_dev;Database=ejadah_ai;Maximum Pool Size=40
JWT_SIGNING_KEY=local-rehearsal-signing-key-local-rehearsal-signing-key-local-rehearsal-0123456789
ANTHROPIC_API_KEY=
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
TILE_URL=
TILE_ATTRIBUTION=
TAG=local

# no SMS provider yet: the sign-in code is written to the api log (docker compose logs api)
SMS_PROVIDER=dummy
SMS_ALLOW_DUMMY=true
