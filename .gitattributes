# scripts and configs that run on Linux must keep LF line endings
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.env text eol=lf
.env.example text eol=lf
# data files are loaded byte-for-byte by PostgreSQL COPY: no line-ending conversion (multi-line CSV fields)
*.csv -text
*.jsonl -text
